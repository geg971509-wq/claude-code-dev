node_modules
.DS_Store
dist
coverage
.env
*.log
.idea
*.suo
*.lock
!bun.lock
src/utils/vendor/

# Editor config — share launch/tasks/extensions, ignore per-user state
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# AI tool runtime directories. `.claude/` uses the glob form (not `.claude/`)
# because a trailing-slash directory exclusion makes git refuse to descend,
# which would render every `!` negation below dead.
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/hello-agent.md
!.claude/skills/
.claude/skills/*
!.claude/skills/interview/
!.claude/skills/teach-me/
.agents/
.omx/
.omc

# Binary / screenshot files (root only)
/*.png
*.bmp

# Internal system prompt documents (--dump-system-prompt output)
Claude-Opus-*.txt
Claude-Sonnet-*.txt
Claude-Haiku-*.txt

# Python bytecode
__pycache__/
*.pyc

# Local state / personal notes (root only — anchored so same-named source
# directories anywhere in the tree stay visible)
/logs/
/data/
/teach-me/
credentials.json

# Session-scoped progress / state files written by agents and skills
# (autofix-pr persistence, test-progress checkpoint, recovery notes).
# Transient, never meant to enter the repo.
.claude-impl-state.md
.claude-progress.md
.claude-recovery.md
.test-progress.md
.squash-tmp/
.git.*-backup
